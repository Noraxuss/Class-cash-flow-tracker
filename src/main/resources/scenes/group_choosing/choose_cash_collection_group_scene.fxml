<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cash_flow.controller.ChooseCashCollectionGroupController"
      prefHeight="400.0"
      prefWidth="400.0"
      minHeight="400.0"
      minWidth="400.0"
      spacing="10">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- Overseer selection -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="groupOverseer" text="%choose_group_overseer"/>
        <ComboBox fx:id="groupOverseerBox" prefWidth="230"/>
    </HBox>

    <!-- System response label (conditionally visible) -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="systemResponseLabel"
               wrapText="true"
               visible="false"
               managed="false"
               style="-fx-text-fill: red;"
               maxWidth="360"/>
    </HBox>

    <!-- Add New Overseer Button aligned with content -->
    <HBox alignment="CENTER_LEFT">
        <Button fx:id="addNewOverseerButton"
                text="%add_new_overseer_button"
                onAction="#handleAddNewOverseerButtonClick">
            <tooltip>
                <Tooltip text="%add_new_overseer_tooltip"/>
            </tooltip>
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
        </Button>
    </HBox>

    <!-- Separator -->
    <Separator prefHeight="5" prefWidth="Infinity"/>

    <!-- Group Label -->
    <Label fx:id="cashCollectionGroupLabel"
           text="%cash_collection_group_label"/>

    <!-- List of Cash Collection Groups -->
    <ListView fx:id="cashCollectionGroupListView"
              onMouseClicked="#handleCashCollectionGroupListViewClick"
              fixedCellSize="35.0">
        <tooltip>
            <Tooltip text="%cash_collection_group_list_tooltip"/>
        </tooltip>
    </ListView>

</VBox>
