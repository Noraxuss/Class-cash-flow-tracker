<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ProgressIndicator?>
<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cash_flow.controller.LoadingController"
      alignment="CENTER" spacing="10"
      prefWidth="400" prefHeight="200">

    <!-- Label to display the current status of the loading process -->
    <Label fx:id="statusLabel" text="Starting..." />

    <!-- Default progress indicator for loading scenes -->
    <ProgressIndicator fx:id="spinner" prefHeight="50" prefWidth="50" />

    <!-- Loading bar for showing data management progress -->
    <ProgressBar fx:id="progressBar" prefWidth="200" />

    <!-- Label to display the progress percentage or amount -->
    <Label fx:id="progressLabel" />

    <!-- Additional label for displaying the current step or action -->
    <Label fx:id="currentStepLabel" />
</VBox>
