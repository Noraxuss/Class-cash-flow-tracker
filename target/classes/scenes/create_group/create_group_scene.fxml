<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cash_flow.controller.CreateGroupController"
      spacing="10">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Label text="%title_label" style="-fx-font-size: 16px;" maxWidth="Infinity" alignment="CENTER"/>

    <Label text="%group_name_label"/>
    <HBox maxWidth="Infinity">
        <TextField fx:id="descriptionTextField" prefHeight="25" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Label text="%group_description_label"/>
    <TextField fx:id="nameTextField" prefHeight="99" maxWidth="Infinity"/>

    <HBox spacing="20" maxWidth="Infinity">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="%start_date"/>
            <DatePicker fx:id="creationDate" maxWidth="Infinity">
                <tooltip>
                    <Tooltip text="%group_creation_date_choosing_tip"/>
                </tooltip>
            </DatePicker>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="%end_date"/>
            <DatePicker fx:id="endDate" maxWidth="Infinity">
                <tooltip>
                    <Tooltip text="%group_end_date_choosing_tip"/>
                </tooltip>
            </DatePicker>
        </VBox>
    </HBox>

    <HBox spacing="20" maxWidth="Infinity" alignment="CENTER">
        <Button fx:id="createGroup" mnemonicParsing="false" onMouseClicked="#createGroupButtonClicked"
                text="%create_group_button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="back" mnemonicParsing="false" onMouseClicked="#backButtonClicked"
                text="%back_button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

</VBox>
