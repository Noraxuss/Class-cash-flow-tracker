<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<TitledPane animated="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            text="%title_pane_label" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="cash_flow.controller.AddGroupMembersController">

    <VBox>
        <TableView fx:id="membersTableView">
            <columns>
                <TableColumn fx:id="firstNameColumn" id="memberFirstName" text="">
                    <graphic>
                        <Label text="%first_name_column">
                            <tooltip><Tooltip text="%first_name_column"/></tooltip>
                        </Label>
                    </graphic>
                </TableColumn>

                <TableColumn fx:id="lastNameColumn" id="memberLastName" text="">
                    <graphic>
                        <Label text="%last_name_column">
                            <tooltip><Tooltip text="%last_name_column"/></tooltip>
                        </Label>
                    </graphic>
                </TableColumn>

                <TableColumn fx:id="emailColumn" id="memberEmail" text="">
                    <graphic>
                        <Label text="%e-mail_column">
                            <tooltip><Tooltip text="%e-mail_column"/></tooltip>
                        </Label>
                    </graphic>
                </TableColumn>

                <TableColumn fx:id="joinDateColumn" id="memberJoinDate" text="">
                    <graphic>
                        <Label text="%join_date_column">
                            <tooltip><Tooltip text="%join_date_column"/></tooltip>
                        </Label>
                    </graphic>
                </TableColumn>

                <TableColumn fx:id="optionalColumn" id="optional" text="">
                    <graphic>
                        <Label text="%optional_column">
                            <tooltip><Tooltip text="%optional_column"/></tooltip>
                        </Label>
                    </graphic>
                    <columns>
                        <TableColumn fx:id="guardianFirstNameColumn" id="guardianFirstName" text="">
                            <graphic>
                                <Label text="%parent_first_name">
                                    <tooltip><Tooltip text="%parent_first_name"/></tooltip>
                                </Label>
                            </graphic>
                        </TableColumn>

                        <TableColumn fx:id="guardianLastNameColumn" id="guardianLastName" text="">
                            <graphic>
                                <Label text="%parent_last_name">
                                    <tooltip><Tooltip text="%parent_last_name"/></tooltip>
                                </Label>
                            </graphic>
                        </TableColumn>

                        <TableColumn fx:id="guardianEmailColumn" id="guardianEmail" text="">
                            <graphic>
                                <Label text="%parent_e-mail_column">
                                    <tooltip><Tooltip text="%parent_e-mail_column"/></tooltip>
                                </Label>
                            </graphic>
                        </TableColumn>
                    </columns>
                </TableColumn>
            </columns>
        </TableView>

        <HBox fx:id="buttonsHBox" alignment="CENTER" spacing="10.0">
            <Button fx:id="saveChangesButton" mnemonicParsing="false"
                    text="%save_changes_button" onAction="#saveChangesClicked">
            </Button>
            <Button fx:id="backButton" mnemonicParsing="false"
                    text="%back_button" onAction="#backButtonClicked"/>
        </HBox>
    </VBox>
</TitledPane>
